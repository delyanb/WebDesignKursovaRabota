@page "/books/{BookId:int}"
@inject HttpClient Http
@using System.Globalization
@using Models
@using WebDesign.Services
@inject PageHeaderService HeaderService


@if (IsLoading)
{
    <div class="container mt-4">
        <div class="card shadow-sm p-4 book-details-skeleton-card">
            <div class="row">
                <div class="col-md-4">
                    <div class="book-details-skeleton-img"></div>
                </div>
                <div class="col-md-8">
                    <div class="book-details-skeleton-line w-75"></div>
                    <div class="book-details-skeleton-line w-50"></div>
                    <div class="book-details-skeleton-line w-25"></div>
                    <div class="book-details-skeleton-block mt-3"></div>
                </div>
            </div>
        </div>
    </div>
}
else if (Error != null)
{
    <div class="alert alert-danger text-center mt-4">
        ❗ @Error
    </div>
}
else if (GivenBook != null)
{


    <div class="container mt-4 book-details-animate-in">
        <div class="card book-details-card shadow-lg">
            <div class="row g-0">
                <!-- Cover -->
                <div class="col-md-4 book-details-cover-column">
                    <img src="@GivenBook.ImageUrl"
                         alt="@GivenBook.Title"
                         class="img-fluid book-details-cover" />
                </div>

                <!-- Info -->
                <div class="col-md-8">
                    <div class="card-body d-flex flex-column h-100">
                        <h2 class="fw-bold mb-2">@GivenBook.Title</h2>

                        <p class="text-muted mb-3">
                            by <strong>@GivenBook.Author</strong>
                        </p>

                        <span class="badge bg-success book-details-price-badge mb-3">
                            @GivenBook.Price.ToString("C", CultureInfo.CurrentCulture)
                        </span>

                        <p class="book-details-description">
                            @GivenBook.Description
                        </p>

                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <a href="@BackUrl" class="btn btn-outline-secondary">
                                ← Back to list
                            </a>

                            <button class="btn btn-primary disabled">
                                Add to Cart 🛒
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center mt-5 text-muted">
        <h4>📕 Book not found</h4>
        <p>The book you’re looking for doesn’t exist.</p>
        <a href="@BackUrl" class="btn btn-outline-secondary mt-2">
            Go back
        </a>
    </div>
}

@code {
    [Parameter]
    public int BookId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "from")]
    public string? FromPage { get; set; }

    private string BackUrl => FromPage switch
    {
        "best-sellers" => "/best-sellers",
        "books" => "/books",
        _ => "/books"
    };


    private Book? GivenBook { get; set; }
    private bool IsLoading { get; set; } = true;
    private string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        HeaderService.Title = "📖 Book Details";
        try
        {
            var response = await Http.GetFromJsonAsync<WebDesignAPI.Models.GetBookByIdResponse>($"https://localhost:7078/Books/{BookId}");

            if (response == null || !response.Success || response.Book == null) 
            { 
                Error = "Error retrieving book data.";
                IsLoading = false;
                return;
            }

            GivenBook = new Book()
            {
                Author = response.Book.Author,
                Description = response.Book.Description,
                Id = response.Book.Id,
                Title = response.Book.Title,
                Price = response.Book.Price,
                ImageUrl = response.Book.ImageUrl
            };
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }


}