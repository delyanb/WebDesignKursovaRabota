@page "/best-sellers"
@using WebDesign.Models
@using WebDesign.Services
@inject HttpClient Http
@inject PageHeaderService HeaderService

@if (IsLoading)
{
    <div class="best-sellers-podium">
        <!-- Top 3 skeleton -->
        <div class="podium-top3">
            @for (int i = 0; i < 3; i++)
            {
                <div class="podium-place @(i == 0 ? "place-1" : i == 1 ? "place-2" : "place-3")">
                    <div class="best-sellers-skeleton-card">
                        <div class="best-sellers-skeleton-cover"></div>
                        <div class="best-sellers-skeleton-body">
                            <div class="best-sellers-skeleton-line medium mb-1"></div>
                            <div class="best-sellers-skeleton-line short mb-1"></div>
                            <div class="best-sellers-skeleton-line long mb-2"></div>
                            <div class="best-sellers-skeleton-block mt-auto"></div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Next 2 skeleton -->
        <div class="podium-next2 mt-3">
            @for (int i = 3; i < 5; i++)
            {
                <div class="best-sellers-skeleton-card">
                    <div class="best-sellers-skeleton-cover"></div>
                    <div class="best-sellers-skeleton-body">
                        <div class="best-sellers-skeleton-line medium mb-1"></div>
                        <div class="best-sellers-skeleton-line short mb-1"></div>
                        <div class="best-sellers-skeleton-line long mb-2"></div>
                        <div class="best-sellers-skeleton-block mt-auto"></div>
                    </div>
                </div>
            }
        </div>
    </div>
}
else if (!bestSellers.Any())
{
    <div class="text-center text-muted mt-5">
        <h4>😕 No best sellers found</h4>
        <p>Try again later.</p>
    </div>
}
else
{
    <div class="best-sellers-podium">

        <!-- Top 3 podium -->
        <div class="podium-top3">
            @for (int i = 0; i < Math.Min(3, bestSellers.Count); i++)
            {
                <div class="podium-place @(i == 0 ? "place-1" : i == 1 ? "place-2" : "place-3")">
                    <div class="best-seller-card shadow-sm h-100">
                        <div class="best-seller-cover">
                            <img src="@bestSellers[i].Book.ImageUrl" alt="@bestSellers[i].Book.Title" />
                            <span class="podium-rank">#@(i + 1)</span>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h6 class="mb-1 text-truncate" title="@bestSellers[i].Book.Title">
                                @bestSellers[i].Book.Title
                            </h6>
                            <p class="text-muted small mb-2">@bestSellers[i].Book.Author</p>

                            <span class="badge bg-warning text-dark mt-auto">
                                🔥 @bestSellers[i].SoldThisWeek sold
                            </span>

                            <a class="btn btn-outline-primary btn-sm mt-2"
                               href="/books/@bestSellers[i].Book.Id?from=best-sellers">
                                View details →
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Next 2 (4th & 5th) -->
        <div class="podium-next2 mt-3">
            @for (int i = 3; i < Math.Min(5, bestSellers.Count); i++)
            {
                <div class="best-seller-card shadow-sm">
                    <div class="best-seller-cover">
                        <img src="@bestSellers[i].Book.ImageUrl" alt="@bestSellers[i].Book.Title" />
                        <span class="podium-rank">#@(i + 1)</span>
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h6 class="mb-1 text-truncate" title="@bestSellers[i].Book.Title">
                            @bestSellers[i].Book.Title
                        </h6>
                        <p class="text-muted small mb-2">@bestSellers[i].Book.Author</p>

                        <span class="badge bg-warning text-dark mt-auto">
                            🔥 @bestSellers[i].SoldThisWeek sold
                        </span>

                        <a class="btn btn-outline-primary btn-sm mt-2"
                           href="/books/@bestSellers[i].Book.Id?from=best-sellers">
                            View details →
                        </a>
                    </div>
                </div>
            }
        </div>

    </div>
}



@code {
    private bool IsLoading = true;
    private string? Error;


    private List<BestSellerBook>? bestSellers;


    protected override async Task OnInitializedAsync()
    {
        HeaderService.Title = "🔥 Best Sellers This Week";
        try
        {
            if (bestSellers is not null)
                return;

            var response = await Http.GetFromJsonAsync<GetTopBestSellersResponse>(
            "https://localhost:7078/Books/best-sellers"
            );


            if (response == null || !response.Success)
            {
                Error = response?.ErrorMessage ?? "Unknown error.";
                return;
            }


            bestSellers = response.BestSellers;


        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }
    }